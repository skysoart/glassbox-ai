# --- LLM ---------------------------------------------------------------
# Gemini through its OpenAI-compatible endpoint (the supported default).
LLM_PROVIDER=openai
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Cost accounting. Prices for common models ship in pricing.json; set these
# only when running a model that is not listed there (USD per 1M tokens).
# Leaving them unset makes the UI show "cost unknown" rather than a false $0.
# LLM_PRICE_INPUT=0.10
# LLM_PRICE_OUTPUT=0.40

# --- Agent -------------------------------------------------------------
# Token budget for a single request; the context manager compacts to fit.
CONTEXT_MAX_TOKENS=8000
# How many times the agent may replan after a validation or tool failure.
AGENT_MAX_RETRIES=3
# Hard ceiling on LLM calls per request, so a tool loop cannot run away.
AGENT_MAX_STEPS=8

# --- Storage -----------------------------------------------------------
DATABASE_URL=sqlite:///./glassbox.db

# --- API ---------------------------------------------------------------
# Comma-separated allowed origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The /api/tests/* diagnostics spend real API credit.
ENABLE_TEST_ENDPOINTS=true
